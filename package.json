    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/library": "^0.21.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "jalaali-js": "^2.0.1",
    "jsdom": "^30.1.1",
    "lucide-react": "^0.441.0",
    "postcss": "^8.4.45",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^7.3.2",
    "vitest": "^5.0.2"
  }
